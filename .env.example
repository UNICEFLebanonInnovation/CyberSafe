# CyberSafe Lebanon - example configuration (NO REAL SECRETS)
NODE_ENV=development
API_PORT=3000
DATABASE_URL=postgresql://cybersafe:cybersafe@localhost:5432/cybersafe
REDIS_URL=redis://localhost:6379

OBJECT_STORAGE_ENDPOINT=http://localhost:9000
OBJECT_STORAGE_BUCKET_QUARANTINE=cybersafe-quarantine
OBJECT_STORAGE_BUCKET_ADMIN=cybersafe-admin-source
OBJECT_STORAGE_ACCESS_KEY=CHANGE_ME
OBJECT_STORAGE_SECRET_KEY=CHANGE_ME

PUBLIC_OIDC_ISSUER=https://idp.example/
PUBLIC_OIDC_CLIENT_ID=cybersafe-mobile
STAFF_OIDC_ISSUER=https://staff-idp.example/
STAFF_OIDC_CLIENT_ID=cybersafe-admin

AI_PROVIDER=mock
AI_MODEL=mock-model
AI_API_KEY=CHANGE_ME
EMBEDDING_MODEL=CHANGE_ME

REPUTATION_PROVIDER=disabled
REPUTATION_API_KEY=CHANGE_ME

MALWARE_SCANNER_HOST=clamav
MALWARE_SCANNER_PORT=3310

ANALYSIS_RAW_UPLOAD_TTL_MINUTES=10
CHAT_RETENTION_DAYS=30
GUEST_SESSION_TTL_DAYS=30

RATE_LIMIT_ANALYSIS_PER_HOUR=30
RATE_LIMIT_IMAGE_ANALYSIS_PER_HOUR=15
RATE_LIMIT_CHAT_PER_HOUR=60

OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-collector:4318
SENTRY_DSN=
